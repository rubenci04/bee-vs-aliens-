class_name BeeAlienPalette
extends RefCounted
## One alien visual language for every piece of controlling technology (Style C): the UFO Boss defines it and the
## dragonfly implant, the contaminated-garden device and the alien pylons reuse it, so they read as the same invaders.
##   dark shell + cyan controlled energy + violet accents, emission never above the UFO's emitters.

const CYAN := Color(0.15, 0.95, 1.0)    # = UFO "emitter"
const VIOLET := Color(0.62, 0.22, 0.95) # = UFO "core"
const SHELL := Color(0.2, 0.22, 0.27)   # = UFO "panel"
const MAX_EMISSION := 2.0               # = UFO emitter energy; nothing alien outshines the boss.
