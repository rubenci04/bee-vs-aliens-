extends SceneTree
## Dev tool (LOTE 13 · ETAPA 2.3): prints the dense EVENTS_ROSTER table (GDScript lines) to dev/lote13/events_roster.txt.
## Beats along the route every BEAT_STEP metres with 1-3 insects of the section's pools, always mixing flyers and ground units;
## the three combat zones (waves of 3-4), the moments (opening can, watering can, pre-robot power) and the robot gate are fixed.

const BEAT_STEP := 2.1
const SEED := 1313
const ZONE_WAVES := 6
const P_SINGLE := 0.55
const P_PAIR := 0.35
var rng := RandomNumberGenerator.new()
var lines: Array[String] = []

# [from, to, act, name, air pool, ground pool, ground share]
const SECTIONS := [
	[1.0, 61.0, 1, "CÉSPED", ["FlyCommon", "FlyCommon", "Ladybird", "Wasp", "FlyCommon"], ["Ant", "Ant", "Ant"], 0.30],
	[62.0, 108.0, 2, "MACIZO", ["Wasp", "FlyGreen", "FlyCommon", "FlyCloud", "Ladybird"], ["Ant", "Ant", "WormB"], 0.40],
	[123.0, 178.0, 3, "MACIZO", ["Wasp", "FlyGreen", "FlyCloud", "FlyCommon", "Ladybird", "Wasp"], ["Ant", "WormB", "Ant", "WormA"], 0.42],
	[180.0, 218.0, 4, "ENTRADA DE GUSANOS", ["FlyCommon", "Wasp", "FlyGreen", "FlyCommon", "Ladybird"], ["WormA", "WormB", "WormA", "WormB"], 0.45, 2.8],
	[236.0, 251.0, 4, "HUERTA", ["FlyGreen", "Wasp", "FlyCommon", "FlyCloud"], ["WormA", "WormB", "Snail", "StagBeetle"], 0.50],
	[271.0, 292.0, 4, "SOMBRA", ["Wasp", "FlyGreen", "FlyCommon", "Spider", "Wasp"], ["Ant", "StagBeetle", "MushroomCannon", "Ant"], 0.45],
]
const SECTION_NAMES := {"Ant": "HORMIGA", "WormA": "GUSANO", "WormB": "GUSANO", "Snail": "CARACOL", "StagBeetle": "ESCARABAJO", "MushroomCannon": "HONGO CAÑÓN",
		"FlyCommon": "MOSCA", "FlyGreen": "MOSCA VERDE", "FlyCloud": "NUBE", "Wasp": "AVISPA", "Ladybird": "MARIQUITA", "Spider": "ARAÑA"}
const AIR_HEIGHTS := [2.8, 3.4, 4.0, 4.6, 5.2, 3.0, 4.4, 5.0]

func _initialize() -> void:
	rng.seed = SEED
	build()
	var file := FileAccess.open("res://dev/lote13/events_roster.txt", FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("wrote ", lines.size(), " lines")
	quit(0)

func is_ground(family: String) -> bool:
	return family in ["Ant", "WormA", "WormB", "Snail", "StagBeetle", "MushroomCannon"]

func label_of(section_name: String, units: Array) -> String:
	var parts: Array[String] = []
	for family in units:
		var n: String = SECTION_NAMES[family]
		if not (n in parts):
			parts.append(n)
	return "%s · %s" % [section_name, " Y ".join(parts)]

func event_line(at: float, act: int, label: String, units: Array, extra := "") -> String:
	var q := PackedStringArray()
	for u in units:
		q.append('"%s"' % u)
	var delays := PackedStringArray()
	var ys := PackedStringArray()
	var any_air := false
	for i in units.size():
		delays.append("%.1f" % (float(i) * 0.7 + (0.0 if i == 0 else rng.randf_range(-0.1, 0.2))))
		if is_ground(units[i]):
			ys.append("0.0")
		else:
			ys.append("%.1f" % AIR_HEIGHTS[rng.randi() % AIR_HEIGHTS.size()])
			any_air = true
	var s := '\t{"at": %.1f, "act": %d, "label": "%s", "units": [%s]' % [at, act, label, ", ".join(q)]
	if units.size() > 1:
		s += ', "delays": [%s]' % ", ".join(delays)
	if units.size() > 0 and any_air or units.size() > 1:
		s += ', "y": [%s]' % ", ".join(ys)
	if "Ant" in units:
		s += ', "anthill": true'
	if "Spider" in units:
		s += ', "x": [%s]' % ", ".join(PackedStringArray(units.map(func(u): return "1.2" if u == "Spider" else "0.0")))
	return s + extra + "},"

func pick_group(section: Array) -> Array:
	var size_roll := rng.randf()
	var count := 1 if size_roll < P_SINGLE else (2 if size_roll < P_SINGLE + P_PAIR else 3)
	var air: Array = section[4]
	var ground: Array = section[5]
	var ground_share: float = section[6]
	var group: Array = []
	for i in count:
		var want_ground := rng.randf() < ground_share
		if count >= 2 and i == count - 1 and not group.any(func(f): return is_ground(f)):
			want_ground = true # A group of 2+ always carries a ground unit...
		if count >= 2 and i == 0 and want_ground and not group.any(func(f): return not is_ground(f)):
			pass
		var family: String = ground[rng.randi() % ground.size()] if want_ground else air[rng.randi() % air.size()]
		if family == "Spider" and group.has("Spider"):
			family = "Wasp"
		if family == "MushroomCannon" and group.has("MushroomCannon"):
			family = "Ant"
		group.append(family)
	if count >= 2 and not group.any(func(f): return not is_ground(f)):
		group[0] = air[rng.randi() % air.size()] # ...and a flyer.
	return group

func build() -> void:
	lines.append("\t# LOTE 13 · ETAPA 2 — DENSE table (generated by dev/lote13/_gen_events.gd, seed %d): a beat every %.1f m with 1-3 insects mixing flyers" % [SEED, BEAT_STEP])
	lines.append("\t# and ground units, no breathing valley (the checkpoint-1 stretch is the worm entrance), three combat zones of 6 waves.")
	var events: Array[Dictionary] = []
	# Fixed events.
	events.append({"at": 4.0, "text": '\t{"at": 4.0, "act": 1, "label": "DESPERTAR · LATA GIGANTE", "units": [], "moment": "opening_can"},'})
	events.append({"at": 128.0, "text": '\t{"at": 128.0, "act": 2, "label": "REGADERA · COLUMNAS DE AGUA", "units": [], "moment": "watering_can"},'})
	events.append({"at": 283.0, "text": '\t{"at": 283.0, "act": 4, "label": "POTENCIA · PREPARATE", "units": [], "moment": "preboss_power"},'})
	# Zones (host event + 7 waves).
	events.append({"at": 112.0, "text": zone(112.0, 2, "ZONA DE COMBATE · MACIZO DE FLORES", ["FlyCommon", "Wasp"], ["Ant"],
			[["FlyCommon", "Wasp", "FlyCommon"], ["FlyCloud", "FlyGreen", "Ladybird"], ["Ant", "Wasp", "FlyGreen", "FlyCommon"], ["FlyGreen", "FlyGreen", "FlyCloud", "Ant"],
			["Wasp", "Ladybird", "FlyCommon", "Ant"], ["FlyCommon", "FlyGreen", "Wasp", "WormB"], ["FlyCloud", "Wasp", "Ant", "FlyGreen"]])})
	events.append({"at": 220.0, "text": zone(220.0, 4, "ZONA DE COMBATE · HUERTA", ["WormA", "FlyCommon"], ["Snail"],
			[["WormA", "WormB", "FlyGreen"], ["StagBeetle", "FlyGreen", "FlyCommon"], ["WormB", "WormA", "FlyCloud", "Wasp"], ["WormA", "WormA", "FlyGreen", "FlyCommon"],
			["StagBeetle", "WormB", "FlyCloud", "FlyCommon"], ["WormA", "Snail", "Wasp", "FlyGreen"], ["WormB", "WormA", "FlyCommon", "Wasp"]])})
	events.append({"at": 255.0, "text": zone(255.0, 4, "ZONA DE COMBATE · SOMBRA BAJO LAS HOJAS", ["Spider", "FlyGreen"], ["Ant"],
			[["Ant", "StagBeetle", "FlyGreen"], ["Wasp", "FlyCommon", "Ant"], ["MushroomCannon", "Ladybird", "Ant", "FlyCommon"], ["Spider", "FlyCommon", "FlyCommon", "StagBeetle"],
			["StagBeetle", "Wasp", "Ant", "FlyGreen"], ["MushroomCannon", "FlyCommon", "Wasp", "Ant"], ["Ant", "StagBeetle", "FlyGreen", "FlyCommon"]])})
	# Hard gate before the huerta (replaces the turtle gate: the turtle is out of Level 1 until Rubén delivers a new model).
	events.append({"at": 232.0, "text": '\t{"at": 232.0, "act": 4, "label": "HUERTA · ESCARABAJO, CARACOL Y MOSCA VERDE", "units": ["StagBeetle", "Snail", "FlyGreen"], "delays": [0.0, 0.8, 1.6], "y": [0.0, 0.0, 4.4]},'})
	# Robot gate.
	events.append({"at": 294.0, "text": '\t{"at": 294.0, "act": 4, "label": "ROBOT CAMINANTE · MINIJEFE CON ESCOLTA", "units": ["Walker", "Wasp", "FlyCommon", "FlyCommon"], "hard": true, "miniboss": true,\n\t\t\t"delays": [0.0, 1.2, 2.4, 3.4], "y": [0.0, 4.6, 5.4, 3.0],\n\t\t\t"escort_wave": {"units": ["Wasp", "FlyGreen", "FlyCommon"], "delays": [0.0, 0.9, 1.8], "y": [5.0, 3.4, 4.4]}},'})
	# Beats.
	var blocked: Array[Vector2] = [Vector2(110.0, 124.0), Vector2(218.0, 236.0), Vector2(253.0, 270.0), Vector2(280.0, 284.0), Vector2(293.0, 296.0)] # Zones / gates / power moment + robot gate.
	for section in SECTIONS:
		var x: float = section[0]
		while x <= float(section[1]):
			var skip := false
			for window in blocked:
				if x >= window.x and x <= window.y:
					skip = true
			if not skip and absf(x - 4.0) > 0.6:
				var group := pick_group(section)
				events.append({"at": x, "text": event_line(x, section[2], label_of(section[3], group), group)})
			x += (float(section[7]) if section.size() > 7 else BEAT_STEP)
	events.sort_custom(func(a, b): return float(a["at"]) < float(b["at"]))
	# Beats of overlapping sections (CÉSPED / MACIZO share 62-108): keep one beat per 2.0 m at most.
	var last := -100.0
	var kept: Array[Dictionary] = []
	for e in events:
		if float(e["at"]) - last < 2.0 and not str(e["text"]).contains("moment") and not str(e["text"]).contains("arena") and not str(e["text"]).contains("hard"):
			continue
		kept.append(e)
		last = float(e["at"])
	for e in kept:
		lines.append(e["text"])

func zone(at: float, act: int, label: String, host_units: Array, host_ground: Array, waves: Array) -> String:
	var host: Array = host_units + host_ground
	var text := event_line(at, act, "ZONA · INICIO", host, ',\n\t\t\t"arena_label": "%s", "arena": [' % label)
	text = text.substr(0, text.length() - 2) # Drop the trailing "},".
	for wave_units in waves.slice(0, ZONE_WAVES):
		var w := PackedStringArray()
		var delays := PackedStringArray()
		var ys := PackedStringArray()
		for i in wave_units.size():
			w.append('"%s"' % wave_units[i])
			delays.append("%.1f" % (float(i) * 0.7))
			ys.append("0.0" if is_ground(wave_units[i]) else "%.1f" % AIR_HEIGHTS[rng.randi() % AIR_HEIGHTS.size()])
		var extra := ""
		if "Ant" in wave_units:
			extra += ', "anthill": true'
		if "Spider" in wave_units:
			extra += ', "x": [%s]' % ", ".join(PackedStringArray(wave_units.map(func(u): return "0.6" if u == "Spider" else "0.0")))
		text += '\n\t\t\t{"units": [%s], "delays": [%s], "y": [%s]%s},' % [", ".join(w), ", ".join(delays), ", ".join(ys), extra]
	return text + "\n\t\t]},"
