extends SceneTree
## Dev tool (LOTE 14 · ETAPA 2.1): prints the GRADUAL EVENTS_ROSTER table (GDScript lines) to dev/lote14/events_roster.txt.
## Curve: only common flies for the first ~20 s (one, then two), then one NEW species at a time (ant, ladybird, wasp, green fly, fly
## cloud, worm A, snail, stag beetle, worm B, hanging spider). Every new species debuts ALONE (event key "debut": the director waits for a
## clear field and launches nothing else for DEBUT_SOLO_SECONDS) and the pool of species that mix is capped by the clock:
## <= 2 species until minute 2, <= 3 until minute 4, <= 4 afterwards. A debut also clears the field, so a pool change never overlaps.
## Positions are metres of scroll (cruise 1.25 m/s; each combat zone adds ~24 s); the pacing test measures the real times.

const SEED := 1414
const GROUP_P1 := 0.2 ## Cumulative probabilities of a route beat carrying 1, 2, 3 (else 4) units.
const GROUP_P2 := 0.65
const GROUP_P3 := 1.0
const BEAT_EARLY := 3.6 ## Beat spacing (m) before the dense part.
const BEAT_MID := 2.8
const BEAT_DENSE := 2.0 ## From minute 2 (X ~ 138).
const DEBUT_SPAN := 10.0 ## Metres a solo window covers (8 s of cruise).
var rng := RandomNumberGenerator.new()
var events: Array[Dictionary] = []

const NAMES := {"Ant": "HORMIGA", "WormA": "GUSANO ROSA", "WormB": "GUSANO DE COMPOST", "Snail": "CARACOL", "StagBeetle": "ESCARABAJO", "FlyCommon": "MOSCA",
		"FlyGreen": "MOSCA VERDE", "FlyCloud": "NUBE", "Wasp": "AVISPA", "Ladybird": "MARIQUITA", "Spider": "ARAÑA"}
const AIR_HEIGHTS := [2.8, 3.4, 4.0, 4.6, 5.2, 3.0, 4.4, 5.0]
const GROUND := ["Ant", "WormA", "WormB", "Snail", "StagBeetle"]

# Combat zones: [x, debut family, name, pool of the mixed waves, units in the host event, units of the solo waves]
const ZONES := [
	[138.0, "FlyCloud", "ZONA DE COMBATE · MACIZO DE FLORES", ["FlyCloud", "Ant"], 3, [3, 3]],
	[214.0, "StagBeetle", "ZONA DE COMBATE · HUERTA", ["StagBeetle", "WormA", "Wasp"], 2, [3, 2]],
	[262.0, "Spider", "ZONA DE COMBATE · SOMBRA BAJO LAS HOJAS", ["Wasp", "Ant", "StagBeetle", "Wasp"], 1, [1, 1]],
]
const ZONE_BLOCK := 13.0 ## Metres after a zone start with no route beats.

func _initialize() -> void:
	rng.seed = SEED
	build()
	events.sort_custom(func(a, b): return float(a["at"]) < float(b["at"]))
	var lines: Array[String] = []
	lines.append("\t# LOTE 14 · ETAPA 2 — GRADUAL table (generated by dev/lote14/_gen_events.gd, seed %d): flies only at first, then one new species at a time, each" % SEED)
	lines.append("\t# debuting alone (\"debut\" key); <= 2 species mixed until minute 2, <= 3 until minute 4, <= 4 afterwards.")
	for e in events:
		lines.append(e["text"])
	var file := FileAccess.open("res://dev/lote14/events_roster.txt", FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("wrote ", lines.size(), " lines, ", events.size(), " events")
	quit(0)

func is_ground(family: String) -> bool:
	return family in GROUND

func act_of(x: float) -> int:
	return 1 if x < 62.0 else (2 if x < 123.0 else (3 if x < 180.0 else 4))

func label_of(prefix: String, units: Array) -> String:
	var parts: Array[String] = []
	for family in units:
		var n: String = NAMES[family]
		if not (n in parts):
			parts.append(n)
	return "%s · %s" % [prefix, " Y ".join(parts)]

func add(at: float, text: String) -> void:
	events.append({"at": at, "text": text})

func event_line(at: float, prefix: String, units: Array, extra := "", anthill := true) -> String:
	var q := PackedStringArray()
	for u in units:
		q.append('"%s"' % u)
	var delays := PackedStringArray()
	var ys := PackedStringArray()
	var any_air := false
	for i in units.size():
		delays.append("%.1f" % (float(i) * 0.7 + (0.0 if i == 0 else rng.randf_range(-0.1, 0.2))))
		if is_ground(units[i]):
			ys.append("0.0")
		else:
			ys.append("%.1f" % AIR_HEIGHTS[rng.randi() % AIR_HEIGHTS.size()])
			any_air = true
	var s := '\t{"at": %.1f, "act": %d, "label": "%s", "units": [%s]' % [at, act_of(at), label_of(prefix, units), ", ".join(q)]
	if units.size() > 1:
		s += ', "delays": [%s]' % ", ".join(delays)
	if units.size() > 0 and any_air or units.size() > 1:
		s += ', "y": [%s]' % ", ".join(ys)
	if "Ant" in units and anthill:
		s += ', "anthill": true'
	if "Spider" in units:
		s += ', "x": [%s]' % ", ".join(PackedStringArray(units.map(func(u): return "1.2" if u == "Spider" else "0.0")))
	return s + extra + "},"

## One group (1-3 units) from a pool; a group of 2+ mixes a flyer and a ground unit when the pool has both.
func pick_group(pool: Array, max_size := 4) -> Array:
	var air: Array = pool.filter(func(f): return not is_ground(f))
	var ground: Array = pool.filter(func(f): return is_ground(f))
	var roll := rng.randf()
	var count := 1 if roll < GROUP_P1 else (2 if roll < GROUP_P2 else (3 if roll < GROUP_P3 else 4))
	count = mini(count, max_size)
	var group: Array = []
	for i in count:
		var want_ground := not ground.is_empty() and (air.is_empty() or rng.randf() < 0.45)
		var family: String = ground[rng.randi() % ground.size()] if want_ground else air[rng.randi() % air.size()]
		if family == "Spider" and group.has("Spider"):
			family = "Wasp" if "Wasp" in pool else family
		group.append(family)
	if count >= 2 and not air.is_empty() and not ground.is_empty():
		if not group.any(func(f): return is_ground(f)):
			group[count - 1] = ground[rng.randi() % ground.size()]
		if not group.any(func(f): return not is_ground(f)):
			group[0] = air[rng.randi() % air.size()]
	return group

func beats(x0: float, x1: float, step: float, pool: Array, prefix: String, clear_first := false) -> void:
	var x := x0
	var first := true
	while x <= x1:
		var group := pick_group(pool)
		add(x, event_line(x, prefix, group, ', "clear": true' if first and clear_first else ""))
		first = false
		x += step

## A debut: a first group (event with "debut") and two refills of the SAME species inside the solo window.
func debut(x: float, family: String, counts: Array, prefix: String) -> void:
	var step: float = DEBUT_SPAN / float(counts.size())
	for i in counts.size():
		var group: Array = []
		for k in int(counts[i]):
			group.append(family)
		var extra := ', "debut": "%s"' % family if i == 0 else ""
		add(x + step * i, event_line(x + step * i, prefix, group, extra))

func zone(z: Array, waves: Array) -> void:
	var at: float = z[0]
	var family: String = z[1]
	var host: Array = []
	for k in int(z[4]):
		host.append(family)
	var text := event_line(at, "ZONA · INICIO", host, ',\n\t\t\t"debut": "%s", "arena_label": "%s", "arena": [' % [family, z[2]])
	text = text.substr(0, text.length() - 2) # Drop the trailing "},".
	for wave_units in waves:
		var w := PackedStringArray()
		var delays := PackedStringArray()
		var ys := PackedStringArray()
		for i in wave_units.size():
			w.append('"%s"' % wave_units[i])
			delays.append("%.1f" % (float(i) * 0.7))
			ys.append("0.0" if is_ground(wave_units[i]) else "%.1f" % AIR_HEIGHTS[rng.randi() % AIR_HEIGHTS.size()])
		var extra := ""
		if "Ant" in wave_units:
			extra += ', "anthill": true'
		if "Spider" in wave_units:
			extra += ', "x": [%s]' % ", ".join(PackedStringArray(wave_units.map(func(u): return "0.6" if u == "Spider" else "0.0")))
		text += '\n\t\t\t{"units": [%s], "delays": [%s], "y": [%s]%s},' % [", ".join(w), ", ".join(delays), ", ".join(ys), extra]
	add(at, text + "\n\t\t]},")

func zone_waves(z: Array) -> Array:
	var family: String = z[1]
	var pool: Array = z[3]
	var waves: Array = [] # Solo waves (the debut), then mixed waves.
	for n in z[5]:
		var solo: Array = []
		for k in int(n):
			solo.append(family)
		waves.append(solo)
	for i in 5:
		var group := pick_group(pool, 4)
		while group.size() < 3:
			group.append(pool[rng.randi() % pool.size()])
		waves.append(group.slice(0, 4))
	return waves

func build() -> void:
	# --- First seconds: common flies only, one at a time and then two (X < 24, ~20 s) ------------------------------------
	add(4.0, '\t{"at": 4.0, "act": 1, "label": "DESPERTAR · LATA GIGANTE", "units": [], "moment": "opening_can"},')
	add(1.5, event_line(1.5, "CÉSPED", ["FlyCommon"]))
	add(6.5, event_line(6.5, "CÉSPED", ["FlyCommon"]))
	add(11.5, event_line(11.5, "CÉSPED", ["FlyCommon", "FlyCommon"]))
	add(16.5, event_line(16.5, "CÉSPED", ["FlyCommon", "FlyCommon"]))
	# --- One species at a time ---------------------------------------------------------------------------------------------
	debut(26.0, "Ant", [1, 1, 2], "CÉSPED")
	beats(41.0, 50.0, BEAT_EARLY, ["FlyCommon", "Ant"], "CÉSPED")
	debut(52.0, "Ladybird", [1, 1, 1], "CÉSPED")
	beats(65.0, 74.0, BEAT_EARLY, ["Ladybird", "Ant"], "MACIZO")
	debut(76.0, "Wasp", [1, 1, 2], "MACIZO")
	beats(89.0, 98.0, BEAT_EARLY, ["Wasp", "Ant"], "MACIZO")
	debut(100.0, "FlyGreen", [1, 1, 2], "MACIZO")
	beats(113.0, 126.0, BEAT_MID, ["FlyGreen", "Ant"], "MACIZO")
	add(128.0, '\t{"at": 128.0, "act": 2, "label": "REGADERA · COLUMNAS DE AGUA", "units": [], "moment": "watering_can"},')
	zone(ZONES[0], zone_waves(ZONES[0]))
	beats(149.0, 154.0, BEAT_DENSE, ["Wasp", "Ant", "FlyCloud"], "MACIZO")
	debut(156.0, "WormA", [4, 3, 3], "MACIZO")
	beats(169.0, 183.0, BEAT_DENSE, ["WormA", "Ladybird", "FlyCommon"], "MACIZO")
	debut(185.0, "Snail", [3, 2, 2], "ENTRADA DE GUSANOS")
	beats(198.0, 211.0, BEAT_DENSE, ["Snail", "WormA", "FlyGreen"], "HUERTA")
	zone(ZONES[1], zone_waves(ZONES[1]))
	beats(227.0, 233.0, BEAT_DENSE, ["StagBeetle", "WormA", "Wasp"], "HUERTA")
	debut(235.0, "WormB", [3, 2, 2], "HUERTA")
	beats(248.0, 260.0, BEAT_DENSE, ["WormB", "FlyGreen", "StagBeetle", "FlyCommon"], "HUERTA")
	zone(ZONES[2], zone_waves(ZONES[2]))
	beats(276.0, 281.0, BEAT_DENSE, ["Ant", "Wasp", "StagBeetle"], "SOMBRA")
	beats(284.5, 291.5, BEAT_DENSE, ["Wasp", "Ant", "StagBeetle"], "SOMBRA")
	add(283.0, '\t{"at": 283.0, "act": 4, "label": "POTENCIA · PREPARATE", "units": [], "moment": "preboss_power"},')
	# Robot gate (unchanged).
	add(294.0, '\t{"at": 294.0, "act": 4, "label": "ROBOT CAMINANTE · MINIJEFE CON ESCOLTA", "units": ["Walker", "Wasp", "FlyCommon", "FlyCommon"], "hard": true, "miniboss": true,\n\t\t\t"delays": [0.0, 1.2, 2.4, 3.4], "y": [0.0, 4.6, 5.4, 3.0],\n\t\t\t"escort_wave": {"units": ["Wasp", "FlyGreen", "FlyCommon"], "delays": [0.0, 0.9, 1.8], "y": [5.0, 3.4, 4.4]}},')
